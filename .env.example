# === Credenciales de Twilio ===
# Consíguelas en https://console.twilio.com (regístrate gratis)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_aqui

# Número emisor. Para SMS: tu número Twilio (+1234567890)
# Para WhatsApp usa el formato: whatsapp:+14155238886
TWILIO_FROM=+1234567890

# Canal: "sms" o "whatsapp"
CHANNEL=sms

# === Reglas de cumplimiento ===
# Horario permitido para enviar (formato 24h, hora local)
SEND_START_HOUR=9
SEND_END_HOUR=20

# Segundos de pausa entre mensaje y mensaje (evita spam/bloqueos)
RATE_LIMIT_SECONDS=1.5

# Máximo de mensajes por corrida
MAX_PER_RUN=500
